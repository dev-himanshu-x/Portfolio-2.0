{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!out",
      "!node_modules",
      "!docs",
      "!next-env.d.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noArrayIndexKey": "off",
        "noDuplicateProperties": "off"
      },
      "a11y": { "noSvgWithoutTitle": "off" },
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "performance": { "noImgElement": "off" }
    }
  },
  "css": { "parser": { "cssModules": false } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
